<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FrameFlow.UI.Views.AdvancedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource FfInk3Brush}" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource FfInkBrush}" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource FfLabel}">
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Style="{StaticResource FfGhostButton}" Click="OnBack" AutomationProperties.Name="Back">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>
            <TextBlock Text="Advanced" FontFamily="{StaticResource FfDisplayFont}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource FfInkBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="14">
                    <StackPanel>
                        <TextBlock Text="INTEGRATION" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource FfCard}" Padding="22,14">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Game" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="1" Text="Graphics API detected" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ApiValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="2" Text="Limit method" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MethodValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="3" Text="Integration" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="IntegrationValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="4" Text="NVIDIA driver" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="NvidiaValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="5" Text="Measurement" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="MeasurementValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="6" Text="Pacing precision" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="PrecisionValue" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="7" Text="Why it was detected" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ReasonsValue" Text="—" Style="{StaticResource Val}" FontWeight="Normal" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource FfCard}" Padding="22,6,22,14">
                            <StackPanel>
                                <Grid Padding="0,12">
                                    <StackPanel Margin="0,0,64,0">
                                        <TextBlock Text="Debug logging" FontSize="14" FontWeight="Medium" Foreground="{StaticResource FfInkBrush}" />
                                        <TextBlock Text="More detail in engine.log. Leave off for everyday use." FontSize="12" Foreground="{StaticResource FfInk3Brush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DebugLogging" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                                  Toggled="OnDebugLogging" AutomationProperties.Name="Debug logging" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open logs" Style="{StaticResource FfSoftButton}" Padding="14,6" Click="OnOpenLogs" />
                                    <Button Content="Open profiles" Style="{StaticResource FfSoftButton}" Padding="14,6" Click="OnOpenProfiles" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <StackPanel>
                        <TextBlock Text="LIVE STATISTICS" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource FfCard}" Padding="22,14">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Average FPS" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AvgFps" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="1" Text="1% / 0.1% low" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Lows" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="2" Text="Frametime avg" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AvgFt" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="3" Text="Frametime min / max" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MinMax" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="4" Text="Frametime deviation" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="Stddev" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="5" Text="Applied limit" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="Applied" Text="—" Style="{StaticResource Val}" />
                                <TextBlock Grid.Row="6" Text="Display" Style="{StaticResource Key}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DisplayValue" Text="—" Style="{StaticResource Val}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="TEST RENDERER" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource FfCard}" Padding="22,14">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Text="DX11 test renderer" FontSize="14" FontWeight="Medium" Foreground="{StaticResource FfInkBrush}" />
                                    <TextBlock Text="A FrameFlow-aware scene for checking pacing on this PC." FontSize="12" Foreground="{StaticResource FfInk3Brush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Launch" Style="{StaticResource FfSoftButton}"
                                        Padding="16,6" Click="OnLaunchRenderer" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
