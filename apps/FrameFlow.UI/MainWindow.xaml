<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FrameFlow.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FrameFlow.UI.Controls"
    xmlns:views="using:FrameFlow.UI.Views"
    Title="FrameFlow">

    <Grid x:Name="Root" Background="{StaticResource FfWindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <!-- ================= Header / custom title bar ================= -->
        <Grid Grid.Row="0" Padding="30,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag region: everything left of the caption buttons. -->
            <Border x:Name="DragRegion" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent" />

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14" IsHitTestVisible="False">
                <Image Width="48" Height="48" Source="Assets/FrameFlow.png" Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FrameFlow" FontFamily="{StaticResource FfDisplayFont}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" />
                    <TextBlock Text="Smooth Frames. Better Games." FontFamily="{StaticResource FfFont}" FontSize="13" Foreground="{StaticResource FfInk2Brush}" Margin="0,-2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" x:Name="StatusPill" Height="34" Padding="14,0" CornerRadius="17" Margin="0,10,8,0"
                    VerticalAlignment="Center" Background="{StaticResource FfPanelBrush}" BorderBrush="{StaticResource FfLineBrush}" BorderThickness="1"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource FfGreenBrush}" />
                    <TextBlock x:Name="StatusText" Text="Running" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource FfInk2Brush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,0,0">
                <Button x:Name="MinimizeButton" Style="{StaticResource FfGhostButton}" Width="44" Height="34" CornerRadius="0"
                        Click="OnMinimize" ToolTipService.ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource FfGhostButton}" Width="44" Height="34" CornerRadius="0,0,0,0"
                        Click="OnClose" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                    <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Main view ================= -->
        <Grid x:Name="MainView" Grid.Row="1" Padding="28,0,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="110" />
                <RowDefinition Height="12" />
                <RowDefinition Height="272" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Current game -->
            <Border Grid.Row="0" Style="{StaticResource FfCard}" Padding="20,0">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="12" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E3FDFD" Offset="0" />
                                <GradientStop Color="#A6E3E9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <FontIcon x:Name="GameGlyph" Glyph="&#xE7FC;" FontSize="28" Foreground="{StaticResource FfTealDeepBrush}" />
                            <Image x:Name="GameIcon" Width="54" Height="54" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT GAME" Style="{StaticResource FfLabel}" />
                        <TextBlock x:Name="GameName" Text="No game running" FontFamily="{StaticResource FfDisplayFont}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource FfInkBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
                            <TextBlock x:Name="GameExe" Text="Start a game; FrameFlow will detect it automatically" Style="{StaticResource FfBody}" FontSize="13.5" VerticalAlignment="Center" />
                            <Ellipse x:Name="GameMetaDot" Width="3" Height="3" Fill="{StaticResource FfInk3Brush}" Opacity="0.6" VerticalAlignment="Center" Visibility="Collapsed" />
                            <StackPanel x:Name="GameStatus" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                                <Grid Width="14" Height="14">
                                    <Ellipse x:Name="GameStatusDisc" Fill="#265BBF8A" />
                                    <FontIcon x:Name="GameStatusGlyph" Glyph="&#xE73E;" FontSize="8" Foreground="{StaticResource FfGreenTextBrush}" />
                                </Grid>
                                <TextBlock x:Name="GameStatusText" Text="Game Detected" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource FfGreenTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="IntegrationNote" Style="{StaticResource FfBody}" FontSize="12" Foreground="{StaticResource FfInk3Brush}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="LaunchGameButton" Grid.Column="2" Style="{StaticResource FfSoftButton}" VerticalAlignment="Center" Padding="15,9" FontSize="13.5" CornerRadius="10" Visibility="Collapsed"
                            Click="OnLaunchGame" Content="Launch with FrameFlow" AutomationProperties.Name="Launch last selected game with FrameFlow hook" />
                    <Button x:Name="ProtectedRiskButton" Grid.Column="2" Style="{StaticResource FfSoftButton}" VerticalAlignment="Center" Padding="12,9" FontSize="12" CornerRadius="10" Visibility="Collapsed"
                            Click="OnProtectedRisk" Content="Play at your own risk" />
                    <Button x:Name="ChangeGameButton" Grid.Column="3" Style="{StaticResource FfSoftButton}" VerticalAlignment="Center" Padding="15,9" FontSize="13.5" CornerRadius="10"
                            AutomationProperties.Name="Change game">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="ChangeGameText" Text="Choose Game" />
                            <FontIcon Glyph="&#xE70D;" FontSize="11" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="ChangeGameFlyout" Placement="BottomEdgeAlignedRight" Opening="OnChangeGameOpening" />
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- FPS limit, frame pacing and metrics -->
            <Border Grid.Row="2" Style="{StaticResource FfCard}" Padding="20,16,20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="FPS LIMIT" Style="{StaticResource FfLabel}" />
                            <Grid Margin="0,0,0,0" Height="76" HorizontalAlignment="Center">
                                <Button x:Name="FpsValueButton" Padding="0" Background="Transparent" BorderThickness="0" Click="OnEditFps"
                                        ToolTipService.ToolTip="Click to type a custom FPS limit" AutomationProperties.Name="FPS limit value, click to edit">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="FpsValue" Text="60" FontFamily="{StaticResource FfDisplayFont}" FontSize="68" FontWeight="SemiBold"
                                                   CharacterSpacing="-30" Foreground="{StaticResource FfInkBrush}" VerticalAlignment="Bottom" LineHeight="76" />
                                        <TextBlock Text="FPS" FontSize="17" FontWeight="Medium" Foreground="{StaticResource FfInk2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="FpsEditor" Visibility="Collapsed" Width="180" FontSize="39" VerticalAlignment="Center"
                                         PlaceholderText="60" KeyDown="OnFpsEditorKeyDown" LostFocus="OnFpsEditorLostFocus"
                                         AutomationProperties.Name="Custom FPS limit (10 to 1000)" InputScope="Number" />
                            </Grid>
                            <TextBlock Text="Click the number for a custom FPS" Style="{StaticResource FfBody}" FontSize="11" />
                            <StackPanel x:Name="SuggestionRow" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="SuggestionLabel" Text="Suggested for 144 Hz" Style="{StaticResource FfBody}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ItemsControl x:Name="SuggestionChips">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" VerticalAlignment="Top" Padding="12,10,14,10" CornerRadius="12"
                                Background="{StaticResource FfPanelBrush}" BorderBrush="{StaticResource FfLineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ToggleButton x:Name="PacingSwitch" Style="{StaticResource FfPacingSwitch}" VerticalAlignment="Center"
                                              Click="OnPacingSwitchClick" AutomationProperties.Name="Frame Pacing" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Frame Pacing" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" />
                                    <TextBlock x:Name="PacingStatus" Text="Disabled" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource FfInk2Brush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <controls:FpsSlider x:Name="Slider" Grid.Row="1" Margin="-4,8,-4,0" />

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,10" CornerRadius="14" Background="{StaticResource FfPanelBrush}" BorderBrush="{StaticResource FfLineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource FfCyanBrush}" BorderBrush="{StaticResource FfLineBrush}" BorderThickness="1">
                                    <Path Data="M1.5,9 L4.5,9 L6.5,4 L10,14 L12,9 L16.5,9" Stroke="{StaticResource FfInkBrush}" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Frametime" FontSize="12" Foreground="{StaticResource FfInk2Brush}" />
                                    <TextBlock Margin="0,2,0,0"><Run x:Name="MetricFrametime" Text="—" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" /><Run Text=" ms" FontSize="12" Foreground="{StaticResource FfInk2Brush}" /></TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="0,4" Background="{StaticResource FfLineBrush}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource FfCyanBrush}" BorderBrush="{StaticResource FfLineBrush}" BorderThickness="1">
                                    <Path Data="M4,15 L4,10 M9,15 L9,4 M14,15 L14,7" Stroke="{StaticResource FfInkBrush}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="19" Height="19" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FPS (avg)" FontSize="12" Foreground="{StaticResource FfInk2Brush}" />
                                    <TextBlock x:Name="MetricFps" Text="—" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Margin="0,4" Background="{StaticResource FfLineBrush}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource FfCyanBrush}" BorderBrush="{StaticResource FfLineBrush}" BorderThickness="1">
                                    <Grid Width="19" Height="19">
                                        <Ellipse Width="18" Height="18" Stroke="{StaticResource FfInkBrush}" StrokeThickness="1.6" />
                                        <Ellipse Width="4" Height="4" Stroke="{StaticResource FfInkBrush}" StrokeThickness="1.6" />
                                        <Path Data="M13,1.5 L13,5 M13,21 L13,24.5 M1.5,13 L5,13 M21,13 L24.5,13" Stroke="{StaticResource FfInkBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="1% Low" FontSize="12" Foreground="{StaticResource FfInk2Brush}" />
                                    <TextBlock x:Name="MetricLow" Text="—" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Frametime stability -->
            <Border Grid.Row="4" Style="{StaticResource FfCard}" Padding="20,14,20,12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Frametime Stability" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource FfInk2Brush}"><Run x:Name="GraphAverage" Text="—" FontWeight="SemiBold" Foreground="{StaticResource FfInkBrush}" /><Run Text=" average" /></TextBlock>
                    </Grid>
                    <controls:FrametimeGraph x:Name="Graph" Grid.Row="1" MinHeight="80" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Secondary pages (same window) ================= -->
        <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Margin="28,0,28,0" />
        <views:AdvancedView x:Name="AdvancedPage" Grid.Row="1" Visibility="Collapsed" Margin="28,0,28,0" />

        <!-- ================= Bottom bar ================= -->
        <Grid Grid.Row="2" Padding="28,0,28,2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SettingsButton" Grid.Column="0" Style="{StaticResource FfGhostButton}" Click="OnOpenSettings" VerticalAlignment="Center" FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource FfInkBrush}" />
                    <TextBlock Text="Settings" FontWeight="Medium" />
                </StackPanel>
            </Button>
            <Border Grid.Column="1" Width="1" Height="18" Background="{StaticResource FfLineBrush}" VerticalAlignment="Center" />
            <Button x:Name="ModeButton" Grid.Column="2" Style="{StaticResource FfGhostButton}" VerticalAlignment="Center" AutomationProperties.Name="Pacing mode">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Pacing Mode" Foreground="{StaticResource FfInk3Brush}" />
                    <TextBlock x:Name="ModeText" Text="Balanced" FontWeight="Medium" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource FfInk2Brush}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <RadioMenuFlyoutItem x:Name="ModeEfficiency" Text="Efficiency — lowest CPU use" GroupName="mode" Click="OnModeClick" Tag="Efficiency" />
                        <RadioMenuFlyoutItem x:Name="ModeBalanced" Text="Balanced — recommended" GroupName="mode" Click="OnModeClick" Tag="Balanced" IsChecked="True" />
                        <RadioMenuFlyoutItem x:Name="ModePrecision" Text="Precision — tightest timing" GroupName="mode" Click="OnModeClick" Tag="Precision" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Refresh Rate" FontSize="13" Foreground="{StaticResource FfInk3Brush}" />
                <TextBlock x:Name="RefreshText" Text="—" FontSize="13" FontWeight="Medium" Foreground="{StaticResource FfInkBrush}" />
            </StackPanel>
            <Border Grid.Column="4" Width="1" Height="18" Background="{StaticResource FfLineBrush}" VerticalAlignment="Center" />
            <Button x:Name="AdvancedButton" Grid.Column="7" Style="{StaticResource FfGhostButton}" Click="OnOpenAdvanced" VerticalAlignment="Center" FontSize="13">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Advanced" FontWeight="Medium" />
                    <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource FfInkBrush}" />
                </StackPanel>
            </Button>
            <Button x:Name="LimitMethodButton" Grid.Column="6" Style="{StaticResource FfGhostButton}" VerticalAlignment="Center" HorizontalAlignment="Left" AutomationProperties.Name="Limit method">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Limiter" Foreground="{StaticResource FfInk3Brush}" />
                    <TextBlock x:Name="LimitMethodText" Text="Off" FontWeight="Medium" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource FfInk2Brush}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <RadioMenuFlyoutItem x:Name="MethodAuto" Text="Off (detect only)" GroupName="limitMethod" Click="OnLimitMethodClick" Tag="auto" IsChecked="True" />
                        <RadioMenuFlyoutItem x:Name="MethodFrameFlow" Text="FrameFlow (enable per run)" GroupName="limitMethod" Click="OnLimitMethodClick" Tag="frameflow" />
                        <RadioMenuFlyoutItem x:Name="MethodDriver" Text="NVIDIA driver" GroupName="limitMethod" Click="OnLimitMethodClick" Tag="driver" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <ToggleButton x:Name="MiniOverlayButton" Grid.Column="5" VerticalAlignment="Center" Click="OnMiniOverlayClick"
                          Content="Mini OSD" ToolTipService.ToolTip="Shows over windowed or borderless games. Live values require a FrameFlow hook or administrator access for ETW." />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="VersionText" Text="v1.0.2" FontSize="11.5" Foreground="{StaticResource FfInk3Brush}" />
                <Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="{StaticResource FfGreenBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineText" Text="Ready" FontSize="11.5" Foreground="{StaticResource FfInk3Brush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
